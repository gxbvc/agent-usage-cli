<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Agent Usage</title>
  <link rel="stylesheet" href="/app.css" />
  <script src="/app.js" defer></script>
</head>
<body>
  <div class="page">
    <header class="page-header">
      <div class="page-header-title">
        <h1>Agent Usage</h1>
        <p class="muted">Claude, Codex, and Grok subscription burn-down</p>
      </div>
      <form id="collect-now" method="post" action="/api/collect">
        <button type="submit">Collect now</button>
      </form>
    </header>

    <% if @view[:stale] %>
      <div class="banner banner-warning" role="status">
        <strong>Stale data.</strong>
        Last collected <%= format_time(@view[:collected_at]) %>. The collector service may not be running
        &mdash; see <code>ruby/AGENTS.md</code> for <code>bin/install-services</code>.
      </div>
    <% end %>

    <% unless @view[:errors].empty? %>
      <div class="banner banner-error" role="status">
        <strong>Partial data.</strong>
        <% @view[:errors].each do |error| %>
          <%= h(error["provider"]) %>: <%= h(error["message"]) %>.
        <% end %>
      </div>
    <% end %>

    <% if @view[:providers].empty? %>
      <div class="empty-state">
        <h2>No usage data yet</h2>
        <p class="muted">
          Run the collector once to populate the dashboard, or click "Collect now" above.
        </p>
        <pre><code>cd ruby &amp;&amp; bin/collector</code></pre>
      </div>
    <% else %>
      <section class="recommendation" aria-live="polite">
        <% if @view[:recommendation] %>
          <p class="recommendation-headline">Use <%= @view[:recommendation][:label] %> next</p>
          <p class="recommendation-reason"><%= @view[:recommendation][:reason] %></p>
        <% else %>
          <p class="recommendation-headline">No recommendation yet</p>
          <p class="recommendation-reason muted">Weekly-window data is not available for any provider.</p>
        <% end %>
      </section>

      <% [
           { key: :weekly, dom_id: "weekly-comparison", title: "Weekly subscription comparison",
             blurb: "Each provider's weekly-duration plan window, normalized to cycle progress so different reset schedules line up on one axis. This is the window recommendations are ranked on." },
           { key: :short, dom_id: "short-comparison", title: "Short-window comparison (~5h)",
             blurb: "Active short-duration windows (roughly 1–8 hours), such as Claude's 5-hour limit. Supports any future provider that reports a window in this range." },
         ].each do |section| %>
        <% entries = @view[:comparison][section[:key]] %>
        <section class="comparison-section" aria-labelledby="<%= section[:dom_id] %>-heading">
          <h2 id="<%= section[:dom_id] %>-heading"><%= section[:title] %></h2>
          <p class="muted comparison-blurb"><%= section[:blurb] %></p>
          <% if entries.empty? %>
            <p class="muted">No active window data in this range yet.</p>
          <% else %>
            <%= render_comparison_chart(entries, section[:dom_id], section[:title]) %>
            <ul class="comparison-legend">
              <% entries.each do |entry| %>
                <li class="comparison-legend-item">
                  <span class="legend-marker legend-marker-<%= entry[:provider] %>" aria-hidden="true"></span>
                  <% if (logo = provider_logo(entry[:provider])) %>
                    <img class="provider-logo" src="/logos/<%= logo %>" alt="" width="18" height="18" />
                  <% end %>
                  <span class="comparison-legend-text">
                    <strong><%= h(entry[:label]) %></strong> &middot; <%= h(entry[:window_label]) %>
                    &middot; <%= format_percent(entry[:remaining_percent]) %> remaining
                    &middot; <%= format_signed_points(entry[:gap_points]) %> vs. ideal
                    &middot; resets in
                    <span data-reset-at="<%= entry[:period_end] %>"><%= format_duration(entry[:reset_countdown_seconds]) %></span>
                  </span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </section>
      <% end %>

      <section class="provider-grid">
        <% @view[:providers].sort_by { |p| @view[:ranking].index(p[:provider]) || 99 }.each do |provider| %>
          <article class="provider-card" aria-labelledby="provider-<%= provider[:provider] %>-title">
            <header class="provider-card-header">
              <span class="rank-badge" aria-hidden="true"><%= @view[:ranking].include?(provider[:provider]) ? "##{@view[:ranking].index(provider[:provider]) + 1}" : "—" %></span>
              <% if (logo = provider_logo(provider[:provider])) %>
                <img class="provider-logo" src="/logos/<%= logo %>" alt="" width="24" height="24" />
              <% end %>
              <h2 id="provider-<%= provider[:provider] %>-title"><%= provider[:label] %></h2>
            </header>

            <% ranking_window = provider[:ranking_window] %>
            <% if ranking_window %>
              <p class="chart-caption"><%= h(ranking_window[:label]) %> window (weekly comparison, ranking)</p>
              <div class="metric-row">
                <div class="metric">
                  <span class="metric-label">Remaining</span>
                  <span class="metric-value"><%= format_percent(ranking_window[:remaining_percent]) %></span>
                </div>
                <div class="metric">
                  <span class="metric-label">Gap vs. ideal</span>
                  <span class="metric-value <%= ranking_window[:gap_points] >= 0 ? 'positive' : 'negative' %>">
                    <%= ranking_window[:gap_points] >= 0 ? "&#9650; ahead" : "&#9660; behind" %>
                    <%= format_signed_points(ranking_window[:gap_points]) %>
                  </span>
                </div>
                <div class="metric">
                  <span class="metric-label">Required burn</span>
                  <span class="metric-value"><%= format_burn(ranking_window[:required_daily_burn]) %></span>
                </div>
                <div class="metric">
                  <span class="metric-label">Resets in</span>
                  <span class="metric-value" data-reset-at="<%= ranking_window[:period_end] %>">
                    <%= format_duration(ranking_window[:reset_countdown_seconds]) %>
                  </span>
                </div>
              </div>
            <% else %>
              <p class="muted">No weekly-window data.</p>
            <% end %>

            <% unless provider[:secondary_windows].empty? %>
              <details class="secondary-windows">
                <summary>Other windows (<%= provider[:secondary_windows].size %>)</summary>
                <% provider[:secondary_windows].each do |window| %>
                  <div class="metric-row secondary-window">
                    <div class="metric">
                      <span class="metric-label"><%= h(window[:label]) %> remaining</span>
                      <span class="metric-value"><%= format_percent(window[:remaining_percent]) %></span>
                    </div>
                    <div class="metric">
                      <span class="metric-label">Gap</span>
                      <span class="metric-value <%= window[:gap_points] >= 0 ? 'positive' : 'negative' %>">
                        <%= format_signed_points(window[:gap_points]) %>
                      </span>
                    </div>
                    <div class="metric">
                      <span class="metric-label">Resets in</span>
                      <span class="metric-value" data-reset-at="<%= window[:period_end] %>">
                        <%= format_duration(window[:reset_countdown_seconds]) %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </details>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>

    <footer class="page-footer">
      <p class="muted">
        Observed <%= format_time(@view[:observed_at]) %> &middot; collected <%= format_time(@view[:collected_at]) %>
        &middot; <%= @view[:complete] ? "all providers reported" : "partial result" %>
      </p>
      <p class="legend muted">
        <span class="legend-item"><span class="legend-swatch legend-ideal"></span> ideal pace</span>
        <span class="legend-item"><span class="legend-swatch legend-actual"></span> actual</span>
        <span class="legend-item"><span class="legend-swatch legend-inferred"></span> inferred start</span>
        <span class="legend-item"><span class="legend-swatch legend-projection"></span> projection</span>
      </p>
    </footer>
  </div>
</body>
</html>
