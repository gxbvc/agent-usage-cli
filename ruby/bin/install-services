#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require_relative "../lib/agent_usage/launchd"

begin
  AgentUsage::Launchd.install!
rescue AgentUsage::Launchd::LaunchctlError => e
  warn "Failed to install agent-usage-cli launchd services: #{e.message}"
  exit 1
end

puts "Installed and started co.gen.agent-usage-collector and co.gen.agent-usage-web"
puts "Logs: #{AgentUsage::Launchd::LOG_DIR}"
