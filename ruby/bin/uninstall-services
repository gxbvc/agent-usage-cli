#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require_relative "../lib/agent_usage/launchd"

begin
  AgentUsage::Launchd.uninstall!
rescue AgentUsage::Launchd::LaunchctlError => e
  warn "Failed to fully uninstall agent-usage-cli launchd services: #{e.message}"
  exit 1
end

puts "Stopped and unloaded agent-usage-cli launchd services (usage.sqlite3 was not touched)"
